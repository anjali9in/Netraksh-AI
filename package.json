{
  "name": "netraksha-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Facial Recognition and Liveness Detection System for Remote Locations",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "backend:install": "npm install --prefix backend",
    "backend:build": "npm run build --prefix backend",
    "backend:typecheck": "npm run typecheck --prefix backend",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^2.0.0",
    "@react-native-community/netinfo": "^9.5.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "6.9.12",
    "axios": "^1.16.1",
    "react": "18.2.0",
    "react-native": "0.72.7",
    "react-native-fast-tflite": "^1.6.0",
    "react-native-keychain": "^8.2.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-screens": "3.22.1",
    "react-native-svg": "^13.14.0",
    "react-native-vision-camera": "^3.6.17"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "^11.3.7",
    "@react-native-community/cli-platform-android": "^11.3.7",
    "@react-native-community/cli-platform-ios": "^11.3.7",
    "@react-native-community/eslint-plugin": "^1.3.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.7",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-ft-flow": "^2.0.3",
    "eslint-plugin-jest": "^26.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.76.8",
    "patch-package": "^8.0.1",
    "prettier": "^2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "\\.(tflite)$": "<rootDir>/__mocks__/fileMock.js"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
